{
  "name": "picky",
  "version": "0.1.0-rc",
  "private": true,
  "description": "Picks which CI tests run for a change: dependency graph first, a model (Jev) for the rest, full run on any doubt.",
  "license": "MIT",
  "repository": "github:ahmedragab20/picky",
  "homepage": "https://ahmedragab20.github.io/picky",
  "type": "module",
  "bin": {
    "picky": "bin/picky"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "test": "bun test --check",
    "typecheck": "bun check && bun check -p src",
    "demo": "bash examples/demo.sh",
    "build": "bun --check scripts/build.ts",
    "bench": "bun check bench/selection.ts && node bench/selection.ts",
    "bench:hero": "bun check bench/hero.ts && node bench/hero.ts",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  }
}
